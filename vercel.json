{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.jacoballen.ca" }],
      "destination": "https://jacoballen.ca/:path*",
      "permanent": true
    },
    { "source": "/github",  "destination": "https://github.com/Allen-Jacob",             "permanent": false },
    { "source": "/x",        "destination": "https://x.com/Bridled01",                   "permanent": false },
    { "source": "/twitter",  "destination": "https://x.com/Bridled01",                   "permanent": false },
    { "source": "/instagram","destination": "https://www.instagram.com/jacob.allen2009/",          "permanent": false },
    { "source": "/strava",  "destination": "https://www.strava.com/athletes/141873421",           "permanent": false },
    { "source": "/email", "destination": "mailto:contact@jacoballen.ca",        "permanent": false },
    { "source": "/starlink", "destination": "https://starlink.com/residential?referral=RC-DF-12693608-83528-7&app_source=share",                 "permanent": false },
    { "source": "/racknerd", "destination": "https://my.racknerd.com/aff.php?aff=15552",                 "permanent": false },
    { "source": "/link", "destination": "/links",                 "permanent": false }
  ]
}
